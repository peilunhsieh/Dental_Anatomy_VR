# ---- Unity-generated folders (rebuilt automatically) ----
# A leading slash means "only at the project root", so folders named
# Build or Logs inside Assets are still tracked.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity asset-database lock file
*.utmp

# Mono crash dumps written by Unity when it crashes
mono_crash.*

# ---- Build outputs ----
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/*
crashlytics-build.properties
sysinfo.txt

# Debug symbols
*.pdb
*.mdb
*.pdb.meta
*.mdb.meta
*_BurstDebugInformation_DoNotShip/

# ---- IDE files (regenerated by Unity) ----
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Mesh exports made by the ExportToObj tool
/[Ee]xported[Oo]bj/

# ---- OS files ----
.DS_Store
._*
Thumbs.db
Desktop.ini
